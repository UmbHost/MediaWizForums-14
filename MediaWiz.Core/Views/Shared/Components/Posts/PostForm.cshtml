@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using MediaWiz.Forums.Controllers
@using MediaWiz.Forums.Extensions
@using MediaWiz.Forums.Models
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Cms.Core.Security
@using Umbraco.Cms.Core.Services
@using Umbraco.Cms.Core.Models
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Extensions

@inject IMemberGroupService MemberGroupService
@inject IIdKeyMap keyMap

@{

    if (UserCanPostHere(Model))
    {
        var user = memberManager.GetCurrentMemberAsync().Result;
        if(user == null)
        {
            <h3>@await DictionaryService.GetOrCreateDictionaryValue("Forums.Posts.LoginToPost", "You must be logged in to post") </h3>
            return;
        }
        var showTitle = false;
        if (TempData["showTitle"] != null)
        {
            showTitle = (bool)TempData["showTitle"];
        }
        var edit = false;
        if (TempData["edit"] != null)
        {
            edit = (bool)TempData["edit"];
        }

        var mode = edit ? await DictionaryService.GetOrCreateDictionaryValue("Forums.Posts.EditPost", "Edit Post") : (showTitle ? await DictionaryService.GetOrCreateDictionaryValue("Forums.Posts.Newpost", "Ask a Question") : await DictionaryService.GetOrCreateDictionaryValue("Forums.Posts.Reply", "Reply to Question"));
        var label = edit ? await DictionaryService.GetOrCreateDictionaryValue("Forums.Posts.Message", "Message") : (showTitle ? await DictionaryService.GetOrCreateDictionaryValue("Forums.Posts.Message", "Message") : await DictionaryService.GetOrCreateDictionaryValue("Forums.Posts.Reply", "Reply"));
        var btn = edit ? await DictionaryService.GetOrCreateDictionaryValue("Forums.Save", "Save") : (showTitle ? await DictionaryService.GetOrCreateDictionaryValue("Forums.Submit", "Submit") : await DictionaryService.GetOrCreateDictionaryValue("Forums.Save", "Save"));

        var Post = new ForumsPostModel();
        IPublishedContent? member = memberManager.AsPublishedMember(user);
        if (edit)
        {
            if (member?.Id != Model.Value<IPublishedContent>("postAuthor")?.Id)
            {
                <h3>@await DictionaryService.GetOrCreateDictionaryValue("Forums.Posts.NotAuthor", "You can't edit this post, you are not the Author") </h3>
                return;
            }
            Post.Id = Model.Id;
            Post.Body = Model.Value<string>("postBody", "");
            Post.Title = Model.Value<string>("postTitle", "");
        }

        Post.AuthorId = member.Id;
        Post.ParentId = Model.Id;
        Post.IsTopic = showTitle;

        <div class="accordion " id="accordionFlushExample">
            <div class="accordion-item">
                <h2 class="accordion-header" id="flush-headingOne">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapseOne" aria-expanded="false" aria-controls="flush-collapseOne">
                        @mode
                    </button>
                </h2>
                <div id="flush-collapseOne" class="accordion-collapse collapse p-3" aria-labelledby="flush-headingOne" data-bs-parent="#accordionFlushExample">
                    @using (Html.BeginUmbracoForm<ForumsSurfaceController>("CreatePost", null, new { @class = "form-horizontal forum-reply-form" }))
                    {
                        <fieldset>
                            @if (showTitle)
                            {
                                <div class="mb-3">
                                        <input asp-for="@Post.Title" class="form-control" aria_required="true" placeholder="Type title" />
                                        <span asp-validation-for="@Post.Title" class="form-text text-danger"></span>
                                </div>
                            }
                            <div class="mb-3">
                                <textarea asp-for="@Post.Body" class="form-control new-post" aria_required="true" rows="10" cols="20"></textarea>
                                <span asp-validation-for="@Post.Body" class="form-text text-danger"></span>
                            </div>
                            <input asp-for="@Post.Id" type="hidden" />
                            <input asp-for="@Post.ParentId" type="hidden" />
                            <input asp-for="@Post.AuthorId" type="hidden" />
                            <input asp-for="@Post.IsTopic" type="hidden" />
                            <div asp-validation-summary="All" class="text-danger" id="postform-validation"></div>
                            <div class="col ms-5 p-2">
                                <button type="submit" class="btn btn-dark">@btn</button> <button type="reset" class="btn btn-secondary btn-cancel">@await DictionaryService.GetOrCreateDictionaryValue("Forums.Cancel", "Cancel")</button>
                            </div>
                        </fieldset>
                    }
                </div>
            </div>
        </div>
    }
}
<storecontent asp-key="script-block">
    <script>
        (function () {
            // Open the reply-form accordion. Uses Bootstrap 5's vanilla Collapse API
            // (the old $(...).collapse('show') jQuery plugin doesn't exist in BS5).
            function showReplyForm() {
                var el = document.getElementById('flush-collapseOne');
                if (el && window.bootstrap && window.bootstrap.Collapse) {
                    window.bootstrap.Collapse.getOrCreateInstance(el).show();
                }
                return el;
            }

            document.addEventListener('DOMContentLoaded', function () {
                // If the reply form re-rendered with validation errors, re-open it.
                var err = document.querySelector('#postform-validation li');
                if (err) {
                    var cs = getComputedStyle(err);
                    var hidden = cs.display === 'none' || cs.visibility === 'hidden' || cs.opacity === '0';
                    if (!hidden) {
                        showReplyForm();
                        var main = document.getElementById('mediawiz-forums');
                        if (main) { main.scrollIntoView({ behavior: 'smooth', block: 'end' }); }
                    }
                }
            });

            // Clicking a post's Quote tool opens the reply accordion (in addition
            // to mediawiz.forums.js inserting the quoted text into the textarea).
            // Registered in the CAPTURE phase (third arg true) because mediawiz's own
            // .post-quote handler calls e.stopPropagation(), which would otherwise
            // stop this bubble-phase listener from ever firing.
            document.addEventListener('click', function (e) {
                if (e.target.closest('.post-quote')) {
                    var el = showReplyForm();
                    if (el) { setTimeout(function () { el.scrollIntoView({ behavior: 'smooth', block: 'center' }); }, 250); }
                }
            }, true);
        })();
    </script>
</storecontent>

@functions {

    public bool UserCanPostHere(IPublishedContent item)
    {
        if (!memberManager.IsLoggedIn())
            return false;

        var canPostGroups = item.Value<string>("canPostGroups");

        // default is any one logged on...
        if (string.IsNullOrWhiteSpace(canPostGroups))
            return true;

        // is the user in any of those groups ?
        var allowedGroupList = new List<string>();
        foreach (var memberGroupStr in canPostGroups.Split(','))
        {
            var key = keyMap.GetKeyForId(Convert.ToInt32(memberGroupStr),UmbracoObjectTypes.MemberGroup).Result;
            var memberGroup = MemberGroupService.GetAsync(key).Result;
            if (memberGroup != null)
            {
                allowedGroupList.Add(memberGroup.Name);
            }
        }
        return memberManager.IsMemberAuthorizedAsync(allowGroups: allowedGroupList).Result;
    }

}

